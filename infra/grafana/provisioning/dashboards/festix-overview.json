      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (process_open_fds{service=~\"$service\"})",
          "legendFormat": "{{service}}"
