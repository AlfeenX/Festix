# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=festix
POSTGRES_PASSWORD=festix_secret
POSTGRES_DB=festix

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://festix:festix_secret@localhost:5672

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
EVENT_SERVICE_URL=http://localhost:3002
SEAT_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006

# API Gateway
GATEWAY_PORT=3000
FRONTEND_URL=http://localhost:3100

# Seat lock TTL (seconds)
SEAT_LOCK_TTL=300

# Waiting room
WAITING_ROOM_MAX_ACTIVE=500
